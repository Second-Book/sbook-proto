### Breakpoint Hook

```typescript
// lib/hooks/use-breakpoint.ts
import { useEffect, useState } from "react"

const breakpoints = {
  sm: 640,
  md: 768,
  lg: 1024,
  xl: 1280,
}

export function useBreakpoint(breakpoint: keyof typeof breakpoints) {
  const [matches, setMatches] = useState(false)

  useEffect(() => {
    const query = `(min-width: ${breakpoints[breakpoint]}px)`
    const mql = window.matchMedia(query)
    setMatches(mql.matches)

    const listener = (e: MediaQueryListEvent) => setMatches(e.matches)
    mql.addEventListener("change", listener)
    return () => mql.removeEventListener("change", listener)
  }, [breakpoint])

  return matches
}
```

## Server/Client Components (MUST)

### Server Component (Default)

```typescript
// app/users/page.tsx
import { db } from "@/lib/db"
import { UserCard } from "@/components/custom/user-card"

export default async function UsersPage() {
  const users = await db.user.findMany()

  return (
    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
      {users.map((user) => (
        <UserCard
          key={user.id}
          name={user.name}
          email={user.email}
          avatarUrl={user.avatar}
        />
      ))}
    </div>
  )
}
```

### Client Component Wrapper

```typescript
// components/custom/dialog-wrapper.tsx
"use client"

import { useState } from "react"
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog"

interface DialogWrapperProps {
  trigger: React.ReactNode
  title: string
  children: React.ReactNode
}

export function DialogWrapper({ trigger, title, children }: DialogWrapperProps) {
  const [open, setOpen] = useState(false)

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>{trigger}</DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>{title}</DialogTitle>
        </DialogHeader>
        {children}
      </DialogContent>
    </Dialog>
  )
}
```

## CSS Modules (MUST)

### Module Pattern

```typescript
// components/TextbookCard/TextbookCard.tsx
import styles from './TextbookCardStyle.module.css';

export function TextbookCard({ title, price }: TextbookCardProps) {
  return (
    <div className={styles.card}>
      <h3 className={styles.title}>{title}</h3>
      <p className={styles.price}>{price}</p>
    </div>
  );
}
```

```css
/* components/TextbookCard/TextbookCardStyle.module.css */
.card {
  @apply rounded-lg border p-4 shadow-md;
}

.title {
  @apply text-lg font-semibold mb-2;
}

.price {
  @apply text-xl font-bold text-primary;
}
```

### Best Practices

- Use CSS modules for component-specific styles
- Combine with Tailwind using `@apply`
- Keep module files co-located with components
- Use descriptive class names

## Icons (MUST)

### FontAwesome Integration

```typescript
// components/UserProfileCard.tsx
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faHeart, faMessage } from "@fortawesome/free-regular-svg-icons";
import { faBook } from "@fortawesome/free-solid-svg-icons";

export function UserProfileCard() {
  return (
    <div>
      <FontAwesomeIcon icon={faBook} />
      <FontAwesomeIcon icon={faHeart} />
      <FontAwesomeIcon icon={faMessage} />
    </div>
  );
}
```

### Icon Organization

- Use `@fortawesome/free-solid-svg-icons` for solid icons
- Use `@fortawesome/free-regular-svg-icons` for regular icons
- Use `@fortawesome/free-brands-svg-icons` for brand icons
- Import only needed icons to reduce bundle size

## Out of Scope

- API routes and server actions (see 603-nextjs-api-testing.mdc)
- Component unit testing (see 603-nextjs-api-testing.mdc)
- Internationalization
- Animation libraries beyond Tailwind
